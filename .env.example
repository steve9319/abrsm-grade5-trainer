# Optional. Without this key the app still runs; missing explanations show "explanation unavailable".
# `npm run check-answers` uses the same variable. It never replaces a stored correctAnswer.
# Disagreements are flagged on the question as answerCheck. Blank explanations are filled and saved.
ANTHROPIC_API_KEY=

# Optional override. Defaults to claude-fable-5-1.
ANTHROPIC_MODEL=claude-fable-5-1

# Gitignored folder for questions you extract locally. Defaults to ./private-bank/
# PRIVATE_BANK_DIR=./private-bank

# Auth.js. Generate a secret with: openssl rand -base64 32
AUTH_SECRET=

# Google Cloud OAuth client (Web application).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated allowlist. The app does not ship a fallback list.
# Intended addresses for this practice room:
ALLOWED_EMAILS=stevezaniel@gmail.com,arisatan9319@gmail.com

# Trust the host header on Vercel and localhost.
AUTH_TRUST_HOST=true
