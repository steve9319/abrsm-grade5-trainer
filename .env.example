# Optional. Without this key the app still runs; missing explanations show "explanation unavailable".
# `npm run check-answers` uses the same variable. It never replaces a stored correctAnswer.
# Disagreements are flagged on the question as answerCheck. Blank explanations are filled and saved.
ANTHROPIC_API_KEY=

# Optional override. Defaults to claude-fable-5-1.
ANTHROPIC_MODEL=claude-fable-5-1
